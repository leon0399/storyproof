{
  "name": "storyproof",
  "version": "0.1.0-next.3",
  "description": "Local visual regression testing for Storybook: capture Chromium screenshots, review diffs, and approve baselines committed next to your stories — no cloud service.",
  "keywords": [
    "storybook-addons",
    "storybook",
    "visual-testing",
    "visual-regression-testing",
    "screenshot-testing",
    "snapshot-testing",
    "regression-testing",
    "visual-diff",
    "playwright",
    "chromium",
    "testing",
    "addon"
  ],
  "homepage": "https://storyproof.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leon0399/storyproof.git",
    "directory": "packages/storyproof"
  },
  "bugs": "https://github.com/leon0399/storyproof/issues",
  "author": "Leonid Meleshin (https://leon0399.me)",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "storybook": {
    "displayName": "Storyproof",
    "icon": "https://storyproof.dev/icon.svg",
    "supportedFrameworks": [
      "react"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:visual": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./manager": "./dist/manager.js",
    "./preset": "./dist/preset.js",
    "./preview": "./dist/preview.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@storybook/icons": "2.1.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@playwright/test": "1.62.1",
    "@storybook/react-vite": "^10.5.0",
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.72.0",
    "playwright": "1.62.1",
    "publint": "^0.3.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.5.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.20.3",
    "typescript": "7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "playwright": "^1.55.1",
    "react": "^19.0.0",
    "storybook": "^10.5.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
