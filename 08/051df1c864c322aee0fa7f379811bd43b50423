 kill \"$sb_pid\"\n        env:\n          STORYPROOF_CONTAINER: \"1\"\n      - name: Storybook logs\n        if: failure()\n        run: cat /tmp/sb.log 2>/dev/null || true\n\n  # Proves the packed tarball works outside pnpm workspace resolution.\n  # Copies an example out before install (no node_modules leak), installs\n  # the archive, and runs the acceptance suite against it.\n  consumer:\n    name: consumer (${{ matrix.example }})\n    needs: package\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    strategy:\n      fail-fast: false\n      matrix:\n        example:\n          - react-vite-sb10.5\n          - nextjs-vite-sb10.5\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n      - uses: pnpm/action-setup@0ebf47130e4866e96fce0953f49152a61190b271 # v6.0.9\n      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0\n        with:\n          node-version-file: \".node-version\"\n          cache: pnpm\n      # Before any install — guarantees no node_modules in the copy.\n      - name: Copy the example out of the workspace\n        env:\n          EXAMPLE: ${{ matrix.example }}\n        run: |\n          dir=$(mktemp -d)\n          cp -r \"examples/$EXAMPLE\" \"$dir/project\"\n          echo \"consumer_dir=$dir/project\" >> \"$GITHUB_ENV\"\n      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1\n        with:\n          name: storyproof-package\n          path: /tmp/storyproof-artifact\n      - name: Point the copy at the packed tarball\n        working-directory: ${{ env.consumer_dir }}\n        run: |\n          pnpm pkg set dependencies.storyproof=file:/tmp/storyproof-artifact/package.tgz\n          # `catalog:` won't resolve outside the workspace; inline the version.\n          pw=$(awk '$1 == \"playwright:\" { print $2; exit }' \"$GITHUB_WORKSPACE/pnpm-workspace.yaml\")\n          case \"$pw\" in\